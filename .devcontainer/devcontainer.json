{
  "name": "KCMI QA Lab (Codespaces)",
  "image": "mcr.microsoft.com/playwright:v1.63.0-noble",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "remoteUser": "pwuser",
  "containerEnv": {
    "KCMI_QA_ENV": "codespaces",
    "E2E_BASE_URL": "https://kcmi-preview.josephtete.com",
    "E2E_SKIP_WEBSERVER": "1"
  },
  "postCreateCommand": "cd platform && npm ci",
  "forwardPorts": [9323, 8080],
  "portsAttributes": {
    "9323": {
      "label": "Playwright HTML report",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "Playwright UI Mode (optional)",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-playwright.playwright"],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "features": {},
  "runArgs": ["--ipc=host"]
}
