# KCMI platform — local environment (NAMES ONLY, safe placeholders)

# --- Public / browser-safe ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key-here
# Non-production only: show TEST_PASS path in the registration form UI
# NEXT_PUBLIC_TURNSTILE_TEST_MODE=1

# --- Server-only (never expose to the browser; never prefix with NEXT_PUBLIC_) ---
SUPABASE_SECRET_KEY=your-secret-key-here
TURNSTILE_SECRET_KEY=your-turnstile-secret-key-here
# Non-production only: accept turnstile token TEST_PASS (never in production)
# TURNSTILE_TEST_MODE=1

# Optional Event registration confirmation email (E3). Registration still succeeds if unset.
# RESEND_API_KEY=your-resend-api-key-here
# RESEND_FROM_EMAIL=events@example.com

# Hosted environments: staging | production
# Omit for local development. Do not set staging/production for unit tests.
# KCMI_ENVIRONMENT=staging

# Explicit seed CMS (tests/demo only). Forbidden when KCMI_ENVIRONMENT is staging or production.
# CONTENT_SOURCE=seed

# Local CLI mapping (`npx supabase status -o env`), names only:
#   API_URL          → NEXT_PUBLIC_SUPABASE_URL
#   PUBLISHABLE_KEY  → NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#   SECRET_KEY       → SUPABASE_SECRET_KEY
