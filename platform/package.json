{
  "name": "platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=public --project=hub-setup --project=hub-smoke --project=hub-ui --project=hub-teardown",
    "test:visual": "playwright test --project=public --project=hub-setup --project=hub-visual e2e/public-visual.spec.ts e2e/hub-visual.spec.ts",
    "test:ui": "playwright test --ui",
    "qa:smoke": "playwright test --project=fs-chromium e2e/full-spectrum/smoke.spec.ts e2e/full-spectrum/runtime-network.spec.ts",
    "qa:layout": "playwright test --project=fs-chromium e2e/full-spectrum/responsive-layout.spec.ts",
    "qa:interaction": "playwright test --project=fs-chromium e2e/full-spectrum/public-interactions.spec.ts e2e/full-spectrum/hub-interactions.spec.ts e2e/full-spectrum/program-lifecycle.spec.ts",
    "qa:cross-browser": "playwright test --project=fs-firefox --project=fs-webkit --project=fs-mobile-chrome --project=fs-mobile-webkit e2e/full-spectrum/cross-browser-critical.spec.ts e2e/full-spectrum/public-interactions.spec.ts",
    "qa:cloud:cross-browser": "E2E_SKIP_WEBSERVER=1 E2E_BASE_URL=${E2E_BASE_URL:-https://kcmi-preview.josephtete.com} KCMI_QA_ENV=${KCMI_QA_ENV:-codespaces} playwright test --config=playwright.codespaces.config.ts --project=fs-chromium --project=fs-firefox --project=fs-webkit --project=fs-mobile-chrome --project=fs-mobile-webkit e2e/full-spectrum/cross-browser-critical.spec.ts e2e/full-spectrum/public-interactions.spec.ts e2e/full-spectrum/smoke.spec.ts e2e/full-spectrum/responsive-layout.spec.ts",
    "qa:cloud": "E2E_SKIP_WEBSERVER=1 E2E_BASE_URL=${E2E_BASE_URL:-https://kcmi-preview.josephtete.com} KCMI_QA_ENV=${KCMI_QA_ENV:-codespaces} playwright test --config=playwright.codespaces.config.ts --project=fs-chromium e2e/full-spectrum/smoke.spec.ts e2e/full-spectrum/runtime-network.spec.ts e2e/full-spectrum/responsive-layout.spec.ts e2e/full-spectrum/accessibility.spec.ts e2e/full-spectrum/typography.spec.ts e2e/full-spectrum/links.spec.ts e2e/full-spectrum/content-quality.spec.ts e2e/full-spectrum/public-interactions.spec.ts && npm run qa:cloud:cross-browser",
    "qa:cloud:ui": "E2E_SKIP_WEBSERVER=1 E2E_BASE_URL=${E2E_BASE_URL:-https://kcmi-preview.josephtete.com} KCMI_QA_ENV=${KCMI_QA_ENV:-codespaces} playwright test --config=playwright.codespaces.config.ts --project=fs-chromium --ui --ui-host=0.0.0.0 --ui-port=8080 e2e/full-spectrum/smoke.spec.ts e2e/full-spectrum/public-interactions.spec.ts e2e/full-spectrum/cross-browser-critical.spec.ts",
    "qa:cloud:report": "playwright show-report playwright-report --host 0.0.0.0 --port 9323",
    "qa:a11y": "playwright test --project=fs-chromium e2e/full-spectrum/accessibility.spec.ts",
    "qa:typography": "playwright test --project=fs-chromium e2e/full-spectrum/typography.spec.ts",
    "qa:content": "playwright test --project=fs-chromium e2e/full-spectrum/content-quality.spec.ts",
    "qa:links": "playwright test --project=fs-chromium e2e/full-spectrum/links.spec.ts",
    "qa:runtime": "playwright test --project=fs-chromium e2e/full-spectrum/runtime-network.spec.ts",
    "qa:visual": "QA_VISUAL_SOFT=0 UPDATE_SNAPSHOTS=0 playwright test --project=fs-chromium e2e/full-spectrum/visual-regression.spec.ts",
    "qa:visual:update": "UPDATE_SNAPSHOTS=1 playwright test --project=fs-chromium e2e/full-spectrum/visual-regression.spec.ts",
    "qa:performance": "node scripts/qa-performance.mjs",
    "qa:hosted": "E2E_SKIP_WEBSERVER=1 E2E_BASE_URL=https://kcmi-preview.josephtete.com playwright test --project=fs-chromium e2e/full-spectrum/smoke.spec.ts e2e/full-spectrum/public-interactions.spec.ts e2e/full-spectrum/accessibility.spec.ts",
    "qa:full": "node scripts/qa-full-spectrum-report.mjs",
    "qa:full:v2": "node scripts/qa1-complete-audit.mjs",
    "qa:full:v12": "node scripts/qa12-complete.mjs",
    "qa:full:v13": "node scripts/qa13-complete.mjs",
    "qa:full:v131": "node scripts/qa131-integrity.mjs",
    "qa:ui": "playwright test --ui --project=fs-chromium e2e/full-spectrum",
    "qa:report": "playwright show-report playwright-report",
    "qa:auth": "node scripts/qa-auth.mjs",
    "qa:auth:cleanup": "node scripts/qa-auth-cleanup.mjs",
    "qa:trace": "node scripts/qa-trace.mjs",
    "review:visual": "node scripts/visual-review.mjs",
    "review:d16": "node scripts/qa-d16-release.mjs",
    "review:d16e": "node scripts/qa-d16e-review.mjs",
    "review:d16f": "node scripts/qa-d16f-review.mjs",
    "review:d16-final": "node scripts/qa-d16-final-review.mjs",
    "screenshots": "node scripts/capture-all-viewports.mjs",
    "review:d17": "node scripts/qa-d17-review.mjs",
    "review:d17-v3": "node scripts/capture-d17-review-v3.mjs",
    "review:d17-final": "node scripts/capture-d17-final.mjs",
    "auth:cleanup-d17": "node scripts/cleanup-d17-auth-state.mjs",
    "supabase": "supabase",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "validate:b1": "node scripts/phase-b1-validate.mjs",
    "validate:d11": "node scripts/phase-d11-validate.mjs",
    "hub:bootstrap-staging": "node scripts/bootstrap-staging-hub-users.mjs",
    "hub:bootstrap-production-tech": "node scripts/bootstrap-production-tech-admin.mjs",
    "hub:bootstrap-production-handover": "node scripts/bootstrap-production-handover-staff.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "otpauth": "^9.5.2",
    "supabase": "^2.116.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
